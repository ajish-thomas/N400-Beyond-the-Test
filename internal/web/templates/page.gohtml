{{define "page"}}<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{.Title}} · N400</title><script src="/static/theme.js"></script><link rel="stylesheet" href="/static/app.css"></head>
<body><a class="skip" href="#main">Skip to content</a><header><a class="brand" href="/"><span class="brand-mark">N400</span><span class="brand-caption">A civics field guide</span></a><div class="header-tools"><nav aria-label="Main"><a href="/learn">Learn</a><a href="/library">Library</a><a href="/flashcards">Flashcards</a><a href="/practice">Practice</a><a href="/questions">All questions</a><a href="/questions?deck=6520">65/20 questions</a><a href="/settings">Settings</a></nav><div class="theme-control" hidden><label for="theme">Theme</label><select id="theme" name="theme"><option value="light">Light</option><option value="dark">Dark</option><option value="auto">Auto</option></select></div></div></header>
<main id="main">
{{if .Home}}
<div class="edition"><span>2025 question set</span><span>Study at your own pace / Offline</span></div>
<section class="hero" aria-labelledby="hero-title"><h1 id="hero-title">Your civics<br><em>study desk.</em></h1><div><p class="intro">Start with the official questions. Take your time, recall an answer, and check it against the USCIS text.</p><a class="button" href="/questions/1">Start with question 1 <span aria-hidden="true">↗</span></a><p class="hero-note">One question. A little more understanding.</p></div></section>
<div class="section-heading"><h2>Choose your study set</h2><span class="section-number">01 / The questions</span></div>
<div class="cards"><a href="/questions"><strong>128</strong><span class="deck-title">Official questions</span><span class="deck-description">The complete question set ↗</span></a><a href="/questions?deck=6520"><strong>20</strong><span class="deck-title">Asterisk-marked questions</span><span class="deck-description">The 65/20 study set ↗</span></a></div>
<section class="chapter-feature"><div><p class="eyebrow">02 / Go beyond the answer</p><h2>The U.S. Constitution</h2><p>Chapter 1 · Official USCIS textbook · 25 linked questions</p></div><a class="button" href="/learn/constitution">Read the chapter <span aria-hidden="true">↗</span></a></section>
<p><a href="/learn">Browse all available chapters →</a></p>
<aside class="milestone"><h2>A field guide in progress</h2><p>Question browsing, all 12 chapters’ text editions, three founding documents, spaced flashcards, and official-format practice tests are ready. The rest of the library and current-official lookups are still being built.</p></aside>
{{else if .Learn}}
<section class="collection-intro learn-intro"><div><p class="eyebrow">Learn / Official USCIS textbook</p><h1>{{.Title}}</h1><p class="intro">Read the source material, then return to the questions it covers.</p></div><div class="collection-stat"><strong>{{len .Chapters}}</strong><span>chapters<br>to explore</span><p>{{len .Chapters}} of 12 chapters available as a text edition. More chapters are being transcribed and checked against the source.</p></div></section>
<div class="section-heading collection-heading"><h2>Follow the story</h2><span class="section-number">12 chapters / 2025 textbook</span></div>
<ol class="collection-grid chapter-grid">{{range .Chapters}}<li><a class="collection-card" href="/learn/{{.ID}}"><span class="collection-number">{{printf "%02d" .Number}}</span><span class="collection-meta">Chapter {{.Number}} · Pages {{.SourceStart}}–{{.SourceEnd}}</span><h2>{{.Title}}</h2><span class="collection-detail">{{len .Questions}} linked questions · {{len .Images}} credited images</span><span class="collection-arrow" aria-hidden="true">↗</span></a></li>{{end}}</ol>
{{else if .Chapter}}
{{template "chapter" .}}
{{else if .Library}}
<section class="collection-intro library-intro"><div><p class="eyebrow">Library / Founding documents and more</p><h1>{{.Title}}</h1><p class="intro">Read the source documents behind the questions: the Declaration of Independence, the Constitution and its amendments, historic speeches, symbols and anthems, and landmark Supreme Court cases.</p></div><div class="collection-stat"><strong>{{len .LibraryDocs}}</strong><span>source document{{if ne (len .LibraryDocs) 1}}s{{end}}<br>ready to read</span><p>{{len .LibraryDocs}} document{{if ne (len .LibraryDocs) 1}}s{{end}} available as a text edition. More are being transcribed and checked against the source.</p></div></section>
<div class="section-heading collection-heading"><h2>On the reading table</h2><span class="section-number">Primary source editions</span></div>
<ol class="collection-grid library-grid">{{range .LibraryDocs}}<li><a class="collection-card" href="/library/{{.ID}}"><span class="collection-number">{{if eq .ID "declaration"}}1776{{else if eq .ID "us-constitution"}}1787{{else}}I–XXVII{{end}}</span><span class="collection-meta">{{if eq .Kind "founding-document"}}Founding document{{else}}{{.Kind}}{{end}} · Pages {{.SourceStart}}–{{.SourceEnd}}</span><h2>{{.Title}}</h2><span class="collection-detail">{{len .Questions}} linked questions</span><span class="collection-arrow" aria-hidden="true">↗</span></a></li>{{end}}</ol>
{{else if .LibraryDoc}}
{{template "library" .}}
{{else if .Practice}}
{{template "practice" .}}
{{else if .Flashcards}}
{{template "flashcards" .}}
{{else if .Settings}}
{{template "settings" .}}
{{else if .Question}}{{with .Question}}
<p class="eyebrow">{{.Section}} / {{.Subsection}}</p><p class="question-index">Question {{.ID}} of 128 {{if .Is6520}}<span class="badge">★ 65/20</span>{{end}}</p><h1 class="prompt">{{.Prompt}}</h1>
<p class="count">{{if gt .RequiredCount 1}}Name {{.RequiredCount}} distinct answers — any {{.RequiredCount}} of the following.{{else}}One acceptable answer is enough.{{end}}</p>
{{if .Changing}}<aside class="warning"><strong>This answer depends on your location or may change.</strong>{{with $.ResolvedAnswers}}<p>{{(index . 0).Source}}{{if (index . 0).AsOf}}, {{(index . 0).AsOf}}{{end}}:</p><ul>{{range .}}<li><strong>{{.Text}}</strong></li>{{end}}</ul>{{with index . 0}}{{if .SourceURL}}<p><a href="{{.SourceURL}}" rel="noreferrer">Source</a></p>{{end}}{{end}}{{end}}<p>Verify at <a href="https://www.uscis.gov/citizenship/testupdates" rel="noreferrer">uscis.gov/citizenship/testupdates</a>.{{if not $.ResolvedAnswers}} Current-official lookup is not available for this question yet.{{end}} The source instructions appear below.</p></aside>{{end}}
<details class="answer"><summary>Reveal official answers</summary><ul>{{range .Answers}}<li>{{.Text}}</li>{{end}}</ul>{{if .Note}}<p>{{.Note}}</p>{{end}}<p class="muted">Parentheses mark optional text. Brackets contain reader guidance.</p>
<label class="self-check"><input type="checkbox"> I got this right</label><p class="muted">Self-check only; this selection is not saved yet. The real test is oral and judged by a USCIS officer.</p></details>
{{end}}{{if .RelatedChapters}}<aside><h2>Read the source chapters</h2><ul>{{range .RelatedChapters}}<li><a href="/learn/{{.ID}}">Chapter {{.Number}} · {{.Title}} ↗</a></li>{{end}}</ul></aside>{{end}}{{if .RelatedLibrary}}<aside><h2>Read the source document</h2><ul>{{range .RelatedLibrary}}<li><a href="/library/{{.ID}}">{{.Title}} ↗</a></li>{{end}}</ul></aside>{{end}}<nav class="pagination" aria-label="Questions">{{if .Previous}}<a href="/questions/{{.Previous}}">← Previous</a>{{end}}<a href="/questions">All questions</a>{{if .Next}}<a href="/questions/{{.Next}}">Next →</a>{{end}}</nav>
{{else}}
<p class="eyebrow">Official USCIS source text</p><h1>{{if .Starred}}The 65/20 study set{{else}}{{.Title}}{{end}}</h1><p>{{len .Questions}} questions. Choose a question to recall and reveal its acceptable answers.</p><ol class="questions">{{range .Questions}}<li value="{{.ID}}"><a href="/questions/{{.ID}}">{{.Prompt}}</a> {{if .Is6520}}<span class="badge">★ 65/20</span>{{end}}{{if gt .RequiredCount 1}}<small>{{.RequiredCount}} distinct answers required</small>{{end}}</li>{{end}}</ol>
{{end}}
</main><footer><span class="footer-label">N400 / A civics field guide</span><span>Source: USCIS, <cite>128 Civics Questions and Answers (2025 version)</cite>, M-1778 (09/25). Independent study tool; not affiliated with USCIS.</span></footer></body></html>{{end}}
