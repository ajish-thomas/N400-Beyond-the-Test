{{define "flashcards"}}
{{with .Flashcard}}<section class="flashcard-intro"><p class="eyebrow">Flashcards / Spaced review</p><h1>Recall it, then decide.</h1><p class="intro">Cards you miss return tomorrow. Each correct recall moves the card farther out: 2, 4, 8, then 16 days.</p><nav class="flashcard-filters" aria-label="Flashcard decks"><a href="/flashcards">All questions</a><a href="/flashcards?deck=6520">65/20 set</a><a href="/flashcards?missed=1">Questions missed more often</a></nav></section>
{{if .Empty}}<section class="flashcard-empty"><p class="eyebrow">No cards due</p><h2>{{if eq .Total 0}}This deck has no cards yet.{{else}}You are caught up for today.{{end}}</h2><p>Choose another deck or come back when your next review is due.</p></section>{{else}}<section class="flashcard" aria-labelledby="card-question"><div class="flashcard-meta"><span>{{.Due}} due today</span><span>Question {{.Question.ID}} of 128</span></div><p class="eyebrow">{{.Question.Section}}</p><h2 id="card-question">{{.Question.Prompt}}</h2><details><summary>Show acceptable official answers</summary><ul>{{range .Question.Answers}}<li>{{.Text}}</li>{{end}}</ul>{{if gt .Question.RequiredCount 1}}<p>Supply {{.Question.RequiredCount}} distinct answers.</p>{{end}}</details><form method="post" action="/flashcards/{{.Question.ID}}"><button class="button" name="result" value="wrong">I missed it <span aria-hidden="true">↺</span></button><button class="button secondary" name="result" value="right">I recalled it <span aria-hidden="true">→</span></button></form></section>{{end}}{{end}}
{{end}}
