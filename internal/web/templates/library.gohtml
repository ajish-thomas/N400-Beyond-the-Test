{{define "library"}}
{{with .LibraryDoc}}
<p class="eyebrow"><a href="/library">Library</a> / Text edition</p>
<h1>{{.Title}}</h1>
{{if eq .Source "citizens-almanac"}}<p class="chapter-source">{{.Citation}}</p>{{else}}<p class="chapter-source">USCIS · <cite>The Declaration of Independence &amp; the Constitution of the United States</cite>, M-654 · Pages {{.SourceStart}}–{{.SourceEnd}}</p>{{end}}
<div class="reader-layout">
<nav class="chapter-toc" aria-label="Document contents"><span class="eyebrow">In this document</span>{{if .CategoryNav}}<div class="timeline">{{range .CategoryNav}}<div class="timeline-era"><span class="timeline-era-label">{{.Name}}<small>{{.Years}}</small></span><ol class="timeline-items">{{range .Items}}<li><a href="#{{.Anchor}}"><span class="timeline-year">{{.Year}}</span><span class="timeline-text">{{.Text}}</span></a></li>{{end}}</ol></div>{{end}}</div>{{else}}{{range .Blocks}}{{if eq .Kind "heading"}}<a href="#{{.Anchor}}">{{.Text}}</a>{{end}}{{end}}{{end}}{{if .Questions}}<a href="#library-questions">Questions covered</a>{{end}}{{if .EditorialNotes}}<a href="#source-notes">Source notes</a>{{end}}</nav>
<article class="chapter-reader" aria-label="Document text">
{{template "blocks" .Blocks}}
{{if .EditorialNotes}}<section class="source-notes" id="source-notes"><h2>Source notes</h2>{{range .EditorialNotes}}<p>{{.}}</p>{{end}}</section>{{end}}
</article></div>
{{end}}
{{if .Questions}}<section id="library-questions"><div class="section-heading"><h2>Questions covered by this document</h2><span class="section-number">{{len .Questions}} questions</span></div>
<p class="muted">Question links are editorial study aids. The source material does not assign question numbers to its text.</p>
<ol class="questions">{{range .Questions}}<li value="{{.ID}}"><a href="/questions/{{.ID}}">{{.Prompt}}</a> {{if .Is6520}}<span class="badge">★ 65/20</span>{{end}}{{if gt .RequiredCount 1}}<small>{{.RequiredCount}} distinct answers required</small>{{end}}{{if .Changing}}<p class="muted">This answer may change. Verify at <a href="https://www.uscis.gov/citizenship/testupdates" rel="noreferrer">uscis.gov/citizenship/testupdates</a>.</p>{{end}}</li>{{end}}</ol></section>{{end}}
{{end}}
