{{define "settings"}}
<p class="eyebrow">Settings / Local study profile</p>
<h1>Set your state.</h1>
<p class="intro">Your state lets the app show your state capital. It is saved only on this device. ZIP, district, and current-officeholder setup will be added separately.</p>
<form class="settings-form" method="post" action="/settings/state"><label for="state">State or District of Columbia</label><select id="state" name="state" required><option value="">Choose a state</option>{{range .States}}<option value="{{.Code}}" {{if eq $.StateCode .Code}}selected{{end}}>{{.Name}}</option>{{end}}</select><button class="button">Save state <span aria-hidden="true">→</span></button></form>
<section class="settings-representative"><h2>Your U.S. representative</h2><p>Find your representative by ZIP or district on the <a href="https://www.house.gov/representatives/find-your-representative" rel="noreferrer">official House lookup</a>, then enter the name here. This value stays only on this device. ZIP-to-district selection is still being added, so the app does not guess.</p><form class="settings-form" method="post" action="/settings/representative"><label for="representative">Representative’s name</label><input id="representative" name="representative" value="{{.Representative}}" required><button class="button">Save representative <span aria-hidden="true">→</span></button></form></section>
{{end}}
