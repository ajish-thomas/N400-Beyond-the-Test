{{define "settings"}}
<p class="eyebrow">Settings / Local study profile</p>
<h1>Set your state.</h1>
<p class="intro">Your state lets the app show your state capital and senators. It is saved only on this device.</p>
<form class="settings-form" method="post" action="/settings/state"><label for="state">State or District of Columbia</label><select id="state" name="state" required><option value="">Choose a state</option>{{range .States}}<option value="{{.Code}}" {{if eq $.StateCode .Code}}selected{{end}}>{{.Name}}</option>{{end}}</select><button class="button">Save state <span aria-hidden="true">→</span></button></form>
<section class="settings-representative"><h2>Congressional district</h2><p>ZIP codes can cross congressional-district lines. Enter your ZIP and choose a listed district if more than one applies. Your ZIP stays only on this device.</p><form class="settings-form" method="post" action="/settings/zip"><label for="zip">ZIP code</label><input id="zip" name="zip" inputmode="numeric" pattern="[0-9]{5}" value="{{.ZIP}}" required><button class="button">Find districts <span aria-hidden="true">→</span></button></form>{{if .Districts}}<form class="settings-form" method="post" action="/settings/district"><label for="district">District candidate{{if gt (len .Districts) 1}}s{{end}}</label><select id="district" name="district" required>{{range .Districts}}<option value="{{.}}" {{if eq $.District .}}selected{{end}}>Congressional District {{.}}</option>{{end}}</select><button class="button">Save district <span aria-hidden="true">→</span></button></form>{{end}}</section>
<section class="settings-representative"><h2>Your U.S. representative</h2><p>Find your representative by ZIP or district on the <a href="https://www.house.gov/representatives/find-your-representative" rel="noreferrer">official House lookup</a>, then enter the name here. This value stays only on this device while the bundled House-member roster is being added.</p><form class="settings-form" method="post" action="/settings/representative"><label for="representative">Representative’s name</label><input id="representative" name="representative" value="{{.Representative}}" required><button class="button">Save representative <span aria-hidden="true">→</span></button></form></section>
<section class="settings-representative"><h2>Refresh current officials</h2>{{if .RefreshError}}<p class="warning">Could not refresh: {{.RefreshError}}. Your previous values, if any, are unchanged.</p>{{end}}{{if .SidecarAsOf}}<p>President, Vice President, Speaker of the House, and Chief Justice were last refreshed {{.SidecarAsOf}} from {{.SidecarSource}}.</p>{{else}}<p>President, Vice President, Speaker of the House, and Chief Justice are shown from the bundled snapshot. Refresh to check for current values.</p>{{end}}<p>Always verify at <a href="https://www.uscis.gov/citizenship/testupdates" rel="noreferrer">uscis.gov/citizenship/testupdates</a> before your interview.</p>{{if .Offline}}<p class="muted">Refresh is disabled while the app is running with --offline.</p>{{else}}<form class="settings-form" method="post" action="/settings/refresh"><button class="button">Refresh current officials <span aria-hidden="true">→</span></button></form>{{if .SidecarAsOf}}<form class="settings-form" method="post" action="/settings/reset-officials"><button class="button secondary">Reset to bundled <span aria-hidden="true">→</span></button></form>{{end}}{{end}}</section>
{{end}}
